# Descomente as linhas abaixo se tiver uma pasta de dados locais grandes:
# data/
# *.csv
# *.xlsx
# *.parquet
# *.sqlite3

# Configurações de IDEs e Editores
.vscode/
.idea/
*.swp

# Variáveis de ambiente e credenciais/chaves de API
.env
*.pem
*.key