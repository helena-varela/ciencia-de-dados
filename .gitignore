# Ambient Virtual / venv (MUITO IMPORTANTE: nunca suba o venv)
.venv/
venv/
ENV/
env/

# Arquivos de código e cache do Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter Notebooks (arquivos temporários e checkpoints)
.ipynb_checkpoints/
*-checkpoint.ipynb

